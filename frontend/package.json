    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.59.0",
    "@types/recharts": "^1.8.29",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
