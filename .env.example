# Shared / backend core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM defaults
LLM_PROVIDER=shopaikey
LLM_MAX_TOKENS=2048
SHOPAIKEY_API_KEY=your_shopaikey_api_key_here
SHOPAIKEY_BASE_URL=https://api.shopaikey.com/v1
SHOPAIKEY_MODEL_NAME=llama-3.1-8b
CHAT_ROUTER_MODEL_NAME=llama-3.1-8b
CHAT_DSL_MODEL_NAME=llama-3.1-8b
CHAT_MAP_MODEL_NAME=llama-3.1-8b
CHAT_REDUCE_MODEL_NAME=llama-3.1-8b
CHAT_ANSWER_MODEL_NAME=llama-3.1-8b
RESUME_PARSE_MODEL_NAME=llama-3.1-8b
RESUME_PARSE_MAX_TOKENS=4096
BATCH_RESUME_PIPELINE_ENABLED=true
RESUME_BATCH_DISPATCH_STALE_SECONDS=15
RESUME_PARSE_WORKER_CONCURRENCY=5
CANDIDATE_EVALUATION_WORKER_CONCURRENCY=1

# Voice interview MVP / scale-up
VOICE_PROVIDER_MODE=browser
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Deepgram low-cost scale-up
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_BASE_URL=https://api.deepgram.com

# OpenAI higher-quality realtime scale-up
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Postgres / MinIO
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_db
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_RESUME_BUCKET=resumes
MINIO_PRESIGNED_GET_EXPIRY_SECONDS=3600

# Google OAuth2 — required for "Sign in with Google"
# See docs/GOOGLE_OAUTH_GCP_SETUP.md for setup instructions
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.send
GOOGLE_OAUTH_ACCESS_TYPE=offline
GOOGLE_OAUTH_PROMPT=consent
GOOGLE_TOKEN_ENCRYPTION_KEY=your-fernet-key-from-step-5
GMAIL_SEND_ENABLED=true
GMAIL_SEND_TIMEOUT_SECONDS=20
FRONTEND_BASE_URL=http://localhost:5173
APP_UI_LANGUAGE=vi

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_UI_LANGUAGE=vi
