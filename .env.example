# Copy this file to .env and fill in your values
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults shown)
LLM_PROVIDER=groq
GROQ_MODEL_NAME=llama-3.1-8b-instant
SECRET_KEY=super-secret-key
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment_db
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_RESUME_BUCKET=resumes
MINIO_PRESIGNED_GET_EXPIRY_SECONDS=3600

# Google OAuth2 — required for "Sign in with Google"
# See docs/GOOGLE_OAUTH_GCP_SETUP.md for setup instructions
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:5173
APP_UI_LANGUAGE=vi
VITE_UI_LANGUAGE=vi
# Backend core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM for report generation
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Voice interview MVP / scale-up
VOICE_PROVIDER_MODE=browser
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Deepgram low-cost scale-up
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_BASE_URL=https://api.deepgram.com

# OpenAI higher-quality realtime scale-up
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
