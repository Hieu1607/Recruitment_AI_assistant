DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECRET_KEY=change-me-in-production

# LLM for report generation
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Voice interview MVP / scale-up
VOICE_PROVIDER_MODE=browser
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Deepgram low-cost scale-up
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_BASE_URL=https://api.deepgram.com

# OpenAI higher-quality realtime scale-up
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

APP_UI_LANGUAGE=vi
